{
  "name": "boyfriend-photo-savior",
  "version": "0.4.1",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "export:web": "expo export --platform web",
    "build:apk": "npx eas-cli@latest build --platform android --profile preview",
    "download:apk": "npx eas-cli@latest build:download --platform android",
    "build:aab": "npx eas-cli@latest build --platform android --profile production",
    "typecheck": "tsc --noEmit",
    "spec:validate": "openspec validate --specs --strict --no-interactive"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.0.1",
    "expo": "~57.0.14",
    "expo-camera": "~57.0.4",
    "expo-file-system": "~57.0.5",
    "expo-image-manipulator": "~57.0.12",
    "expo-image-picker": "~57.0.13",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@fission-ai/openspec": "1.10.0",
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  }
}
